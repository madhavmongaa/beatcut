{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "beatcut-ui",
      "runtimeExecutable": ".venv/bin/beatcut",
      "runtimeArgs": ["ui", "--port", "8765", "--no-open"],
      "port": 8765
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8800", "--bind", "127.0.0.1", "--directory", "docs"],
      "port": 8800
    }
  ]
}
